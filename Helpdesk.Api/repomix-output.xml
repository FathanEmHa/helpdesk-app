<file path="Middleware/ExceptionMiddleware.cs">
 1: using System.Text.Json;
 2: using Helpdesk.Exceptions;
 3: 
 4: namespace Helpdesk.Middleware;
 5: 
 6: public class ExceptionMiddleware
 7: {
 8:     private readonly RequestDelegate _next;
 9: 
10:     public ExceptionMiddleware(RequestDelegate next)
11:     {
12:         _next = next;
13:     }
14: 
15:     public async Task InvokeAsync(HttpContext context)
16:     {
17:         try
18:         {
19:             await _next(context);
20:         }
21:         catch (ValidationException ex)
22:         {
23:             context.Response.StatusCode = ex.StatusCode;
24: 
25:             await context.Response.WriteAsJsonAsync(new
26:             {
27:                 message = ex.Message,
28:                 errors = ex.Errors
29:             });
30:         }
31:         catch (AppException ex)
32:         {
33:             context.Response.StatusCode = ex.StatusCode;
34:             context.Response.ContentType = "application/json";
35: 
36:             await context.Response.WriteAsync(JsonSerializer.Serialize(new
37:             {
38:                 message = ex.Message
39:             }));
40:         }
41:         catch (Exception)
42:         {
43:             context.Response.StatusCode = 500;
44:             context.Response.ContentType = "application/json";
45: 
46:             await context.Response.WriteAsync(JsonSerializer.Serialize(new
47:             {
48:                 message = "Internal server error."
49:             }));
50:         }
51:     }
52: }
</file>

