 56: 
 57:         if (currentUser.Role != Role.Admin)
 58:         {
 59:             query = query.Where(t => t.UserId == currentUser.Id);
 60:         }
 61: 
 62:         if (!string.IsNullOrWhiteSpace(request.Search))
 63:         {
 64:             var keyword = request.Search.Trim();
