<file path="Services/AuthService.cs">
 1: using BCrypt.Net;
 2: using Helpdesk.Data;
 3: using Helpdesk.Dtos.Auth;
 4: using Helpdesk.Models;
 5: using Helpdesk.Exceptions;
 6: using Helpdesk.Helpers;
 7: using Microsoft.EntityFrameworkCore;
 8: 
 9: namespace Helpdesk.Services;
10: 
11: public class AuthService
12: {
13:     private readonly AppDbContext _context;
14:     private readonly JwtService _jwtService;
15: 
16:     public AuthService(AppDbContext context, JwtService jwtService)
17:     {
18:         _context = context;
19:         _jwtService = jwtService;
20:     }
21: 
22:     public async Task<AuthResponse> Login(LoginRequest request)
23:     {
24:         var user = await _context.Users
25:             .FirstOrDefaultAsync(u =>
26:                 u.Email == request.Email &&
27:                 u.Status == UserStatus.Active);
28: 
29:         if (user == null)
30:             throw new UnauthorizedException("Invalid email or password.");
31: 
32:         var validPassword = BCrypt.Net.BCrypt.Verify(
33:             request.Password,
34:             user.PasswordHash
35:         );
36: 
37:         if (!validPassword)
38:             throw new UnauthorizedException("Invalid email or password.");
39: 
40:         var token = _jwtService.GenerateToken(user);
41: 
42:         return new AuthResponse
43:         {
44:             Token = token,
45:             Id = user.Id,
46:             Name = user.Name,
47:             Email = user.Email,
48:             Role = user.Role.ToString()
49:         };
50:     }
51: 
52:     public async Task<MeResponse?> Me(int id)
53:     {
54:         var user = await _context.Users.FindAsync(id);
55: 
56:         if (user == null)
57:             throw new NotFoundException("User not found.");
58: 
59:         return new MeResponse
60:         {
61:             Id = user.Id,
62:             Name = user.Name,
63:             Email = user.Email,
64:             Role = user.Role.ToString()
65:         };
66:     }
67: }
</file>

<file path="Services/CommentService.cs">
  1: using Helpdesk.Data;
  2: using Helpdesk.Exceptions;
  3: using Helpdesk.Helpers;
  4: using Helpdesk.Mappers;
  5: using Helpdesk.Models;
  6: using Helpdesk.Services.Base;
  7: using Helpdesk.Dtos.Comment;
  8: using Microsoft.EntityFrameworkCore;
  9: 
 10: namespace Helpdesk.Services;
 11: 
 12: public class CommentService : BaseService
 13: {
 14:     public CommentService(
 15:         AppDbContext context,
 16:         CurrentUserService currentUserService)
 17:         : base(context, currentUserService)
 18:     {
 19:     }
 20:     
 21:     private async Task<Ticket> GetTicketOrThrow(int id)
 22:     {
 23:         var ticket = await Context.Tickets
 24:             .FirstOrDefaultAsync(t => t.Id == id);
 25: 
 26:         if (ticket == null)
 27:             throw new NotFoundException("Ticket not found.");
 28: 
 29:         return ticket;
 30:     }
 31: 
 32:     private async Task<Comment> GetCommentOrThrow(
 33:         int id,
 34:         bool includeUser = false)
 35:     {
 36:         IQueryable<Comment> query = Context.Comments.AsQueryable();
 37: 
 38:         if (includeUser)
 39:         {
 40:             query = query.Include(c => c.User);
 41:         }
 42: 
 43:         var comment = await query
 44:             .FirstOrDefaultAsync(c => c.Id == id);
 45: 
 46:         if (comment == null)
 47:             throw new NotFoundException("Comment not found.");
 48: 
 49:         return comment;
 50:     }
 51: 
 52:     public async Task<List<CommentResponse>> GetByTicketId(int ticketId)
 53:     {
 54:         var ticket = await GetTicketOrThrow(ticketId);
 55: 
 56:         var currentUser = await GetCurrentUser();
 57: 
 58:         AuthorizationHelper.EnsureOwnerOrAdmin(
 59:             ticket.UserId,
 60:             currentUser);
 61: 
 62:         return await Context.Comments
 63:             .Where(c => c.TicketId == ticketId)
 64:             .OrderBy(c => c.CreatedAt)
 65:             .Select(c => new CommentResponse
 66:             {
 67:                 Id = c.Id,
 68:                 Content = c.Content,
