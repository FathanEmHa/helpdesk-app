 2: using System.Security.Claims;
 3: using System.Text;
 4: using Helpdesk.Models;
 5: using Microsoft.IdentityModel.Tokens;
 6: 
 7: namespace Helpdesk.Services;
 8: 
 9: public class JwtService
10: {
11:     private readonly IConfiguration _configuration;
12: 
13:     public JwtService(IConfiguration configuration)
14:     {
15:         _configuration = configuration;
16:     }
17: 
18:     public string GenerateToken(User user)
19:     {
20:         var claims = new[]
21:         {
22:             new Claim(ClaimTypes.NameIdentifier, user.Id.ToString()),
23:             new Claim(ClaimTypes.Name, user.Name),
24:             new Claim(ClaimTypes.Email, user.Email),
25:             new Claim(ClaimTypes.Role, user.Role.ToString())
26:         };
27: 
28:         var key = new SymmetricSecurityKey(
29:             Encoding.UTF8.GetBytes(_configuration["Jwt:Key"]!)
30:         );
31: 
32:         var credentials = new SigningCredentials(
33:             key,
34:             SecurityAlgorithms.HmacSha256
35:         );
36: 
37:         var token = new JwtSecurityToken(
38:             issuer: _configuration["Jwt:Issuer"],
39:             audience: _configuration["Jwt:Audience"],
40:             claims: claims,
41:             expires: DateTime.UtcNow.AddMinutes(
42:                 int.Parse(_configuration["Jwt:ExpireMinutes"]!)
43:             ),
44:             signingCredentials: credentials
45:         );
46: 
47:         return new JwtSecurityTokenHandler().WriteToken(token);
48:     }
49: }
