<file path="Data/AppDbContext.cs">
 1: using Helpdesk.Models;
 2: using Helpdesk.Models.Base;
 3: using Microsoft.EntityFrameworkCore;
 4: 
 5: namespace Helpdesk.Data;
 6: 
 7: public class AppDbContext : DbContext
 8: {
 9:     public AppDbContext(DbContextOptions<AppDbContext> options)
10:         : base(options)
11:     {
12:     }
13: 
14:     public DbSet<User> Users => Set<User>();
15:     public DbSet<Ticket> Tickets => Set<Ticket>();
16:     public DbSet<Comment> Comments => Set<Comment>();
17: 
18:     public override async Task<int> SaveChangesAsync(
19:         CancellationToken cancellationToken = default)
20:     {
21:         UpdateAuditFields();
22: 
23:         return await base.SaveChangesAsync(cancellationToken);
24:     }
25: 
26:     private void UpdateAuditFields()
27:     {
28:         var utcNow = DateTime.UtcNow;
29: 
30:         foreach (var entry in ChangeTracker.Entries<BaseEntity>())
31:         {
32:             if (entry.State == EntityState.Added)
33:             {
34:                 entry.Entity.CreatedAt = utcNow;
35:             }
36:             else if (entry.State == EntityState.Modified)
37:             {
38:                 entry.Entity.UpdatedAt = utcNow;
39:             }
40:         }
41:     }
42: 
43:     protected override void OnModelCreating(ModelBuilder modelBuilder)
44:     {
45:         modelBuilder.Entity<User>()
46:             .Property(u => u.Role)
47:             .HasConversion<string>();
48: 
49:         modelBuilder.Entity<User>()
50:             .HasQueryFilter(u => u.DeletedAt == null);
51: 
52:         modelBuilder.Entity<Ticket>()
53:             .HasQueryFilter(t => t.DeletedAt == null);
54: 
55:         modelBuilder.Entity<Comment>()
56:             .HasQueryFilter(c => c.DeletedAt == null);
57: 
58:         base.OnModelCreating(modelBuilder);
59:     }
60: }
</file>

