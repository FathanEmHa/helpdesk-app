 80:                 t.Priority == request.Priority.Value);
 81:         }
 82: 
 83:         query = request.SortBy switch
 84:         {
 85:             TicketSortBy.Title => request.Descending
 86:                 ? query.OrderByDescending(t => t.Title)
 87:                 : query.OrderBy(t => t.Title),
